# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tarot:tarot@localhost:5432/tarot
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Khi APP_ENV khác development, secret phải >= 32 ký tự, nếu không app không khởi động.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRE_MINUTES=60

# AI_PROVIDER=gemini: gọi Gemini thật (cần GEMINI_API_KEY)
# AI_PROVIDER=offline: diễn giải mẫu ghép từ ý nghĩa gốc, không gọi mạng (dùng khi dev/test frontend)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Tên model Google đổi/ngừng khá nhanh: kiểm tra https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=2048

DAILY_READING_LIMIT=3
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173
MAX_QUESTION_LENGTH=300
