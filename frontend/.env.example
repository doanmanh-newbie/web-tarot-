# true (mặc định): dùng dữ liệu giả trong trình duyệt, không cần backend. false: gọi backend thật.
VITE_USE_MOCK=false

VITE_API_URL=http://localhost:8000
# Không có màn đăng nhập: frontend tự đăng nhập (tự tạo nếu chưa có) bằng tài khoản demo này.
# Muốn vào trang quản lý bài thì đặt email của tài khoản admin (tạo bằng backend scripts.create_admin).
VITE_DEMO_EMAIL=demo@tarotweb.app
